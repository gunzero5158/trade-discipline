# 数据库：本地开发不填会自动用 SQLite 文件 (dev.db)；线上 (Vercel / NODE_ENV=production) 必须填，否则拒绝启动
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token

# 定时任务密钥：Vercel Cron 调用 /api/cron/snapshot 时自动带在 Authorization 头里；没配则接口拒绝执行
CRON_SECRET=dev-secret-key-change-in-production

# 访问码哈希用的盐：随机生成一串，部署后不要再改 (改了所有访问码都对不上)
# ACCESS_CODE_SALT=

# 新账户默认总资金
DEFAULT_PORTFOLIO_CAPITAL=100000
